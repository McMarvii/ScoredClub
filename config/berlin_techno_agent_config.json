{
  "scoring": {
    "weights": {
      "event_activity": 0.2,
      "online_reach": 0.2,
      "press": 0.15,
      "community": 0.15,
      "networking": 0.1,
      "continuity": 0.1,
      "safety": 0.1
    },
    "bonus_per_item": 5,
    "bonus_cap": 15,
    "malus_per_incident": 5,
    "malus_cap": 15,
    "tier_thresholds": {
      "top": 75,
      "mid": 50,
      "emerging": 25
    },
    "inactive_after_days": 180,
    "confidence": {
      "low_confidence_threshold": 50,
      "freshness_full_days": 45,
      "freshness_floor": 20,
      "unknown_verification_confidence": 30,
      "completeness_weight": 0.7,
      "freshness_weight": 0.3
    }
  },
  "alerts": {
    "score_change_threshold": 10,
    "webhook_url": null,
    "slack_webhook_url": null,
    "email": {
      "enabled": false,
      "smtp_host": "localhost",
      "smtp_port": 587,
      "use_tls": true,
      "username": null,
      "from_addr": "scoredclub@localhost",
      "to_addrs": [],
      "subject_prefix": "[ScoredClub]"
    }
  },
  "sources": {
    "clubcommission_url": "https://www.clubcommission.de/",
    "ra_graphql_url": "https://ra.co/graphql",
    "reddit_search_url": "https://www.reddit.com/search.json",
    "reddit_oauth_token_url": "https://www.reddit.com/api/v1/access_token",
    "reddit_oauth_search_url": "https://oauth.reddit.com/search",
    "reddit_enabled": true,
    "reddit_max_threads": 5,
    "bandsintown_url": "https://rest.bandsintown.com/artists",
    "bandsintown_max_artists": 25,
    "songkick_url": "https://api.songkick.com/api/3.0",
    "songkick_max_artists": 25,
    "sentiment_enabled": false,
    "funding_feed_path": "data/funding/berlin_funding.json",
